# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Runtime configuration for trafficlights-webapp. Placeholders only: never put
# real values in this file, and never commit a filled-in copy (`.env` is
# gitignored).
#
# Where each value is read:
#   - docker compose reads a `.env` next to the compose file (copy this file to
#     `.env`) and substitutes it into compose.dev.yaml / compose.prod.yaml.
#   - Coolify does not read this file: set the same names under the
#     application's Environment Variables.
#   - The server itself reads only the process environment and never loads
#     `.env`. `make dev` (scripts/dev.sh) loads it into the environment for
#     you; for a bare `cargo run`, export the variables in your shell instead.
#
# Unset or blank variables take the server's defaults, shown below. Numbers
# are whole numbers; a malformed value stops the server at startup with a
# message naming the variable.

# --- Network ---------------------------------------------------------------

# BIND: the address and port the server listens on. Unset, it listens on
# 127.0.0.1:3000 (loopback only), which is right for `make dev` and `cargo
# run`. The container image sets 0.0.0.0:3000 itself so the proxy can reach it,
# and compose does not pass it on: leave this commented out unless you also
# change the published port (and, on Coolify, the port in the Domain).
# BIND=0.0.0.0:3000

# PUBLIC_ORIGIN: the exact origin(s) browsers load the app from, comma
# separated, as scheme://host[:port] with no path. The server rejects
# WebSocket upgrades whose Origin header matches none of them (this blocks
# cross-site WebSocket hijacking). Required by compose.prod.yaml.
#   Production (Coolify): the public https URL, without the container port that
#     Coolify's Domain field carries, e.g. https://trafficlights.example.com
#   Local run of compose.prod.yaml: http://127.0.0.1:3000
#   Local development (make dev, make dev-up / compose.dev.yaml): leave it
#     unset, which turns the check off. (`make dev` serves the page from
#     http://127.0.0.1:5173 and warns when this would refuse it.) A set but malformed value is a startup error, never
#     a silently open check.
PUBLIC_ORIGIN=https://trafficlights.example.com

# --- Access ----------------------------------------------------------------

# CREATE_SESSION_PIN: when set, creating a session requires this PIN. Empty
# (or unset) leaves session creation open. In production, set the real value
# only in Coolify's environment, never in a file that is committed.
CREATE_SESSION_PIN=

# --- Sessions and statistics -----------------------------------------------

# DISCONNECT_GRACE_SECONDS: how long a session stays listed as "Receiver
# disconnected" before it ends on its own. The creator can reconnect within
# this time. At least 1. Default 300 (5 minutes).
DISCONNECT_GRACE_SECONDS=300

# LOG_RETENTION_SECONDS: how long an ended session's statistics log stays
# downloadable before it is deleted. 0 deletes it as soon as the session ends.
# Default 600 (10 minutes).
LOG_RETENTION_SECONDS=600

# MAX_SESSIONS: the most sessions that can be active at once. At least 1.
# Default 32.
MAX_SESSIONS=32

# MAX_CONNECTIONS: the most WebSocket connections (lobby and sessions
# together) open at once; further upgrades get HTTP 503. At least 1.
# Default 512.
MAX_CONNECTIONS=512

# LOG_DIR: where each session's statistics `.jsonl` file is written, one file
# per session, streamed to disk rather than held in RAM. The server creates the
# directory itself. In the container this is ephemeral (no volume), which is
# intended: the files vanish with the container. Default /tmp/trafficlights-logs.
LOG_DIR=/tmp/trafficlights-logs

# --- Diagnostics -----------------------------------------------------------

# LOG: the log filter, in tracing's EnvFilter syntax: a level (error, warn,
# info, debug, trace) or per-target directives such as
# `warn,trafficlights_server=debug`. Default info.
LOG=info

# --- Compose only ----------------------------------------------------------

# TRAFFICLIGHTS_IMAGE: the image compose.prod.yaml pulls and runs. The default
# is the tag the publish workflow pushes for main. Not read by the server.
# TRAFFICLIGHTS_IMAGE=ghcr.io/nb-tudelft/trafficlights_webapp:main
